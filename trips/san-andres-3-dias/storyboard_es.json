     "gain": 0.22
    }
   ],
   "steps": false,
   "crowd": [],
   "tag": "DÍA 1"
  },
  {
   "text": "Y para la oreja: aquí se habla creole, un inglés caribeño cantadito, con raíces africanas, que suena parecido al de Jamaica. Es idioma oficial desde 1991, y muchos raizales hablan también español e inglés. Calma total, parce.",
   "media": {
    "type": "file",
    "path": "trips/san-andres-3-dias/img/laloma.jpg",
    "focus": 0.5
   },
   "stick": {
    "action": "wave",
    "x0": 0.55,
    "y": 0.88,
    "size": 420,
    "facing": -1
   },
   "pops": [],
