    "birds"
   ],
   "action_sfx": false,
   "sfx": [],
   "steps": false,
   "crowd": [],
   "tag": "DÍA 1"
  },
  {
   "text": "Bajas a la Laguna Big Pond, agua dulce en medio del monte. Puro silencio, pajaritos, tortugas tomando sol, iguanas en los árboles y caimanes asomando la nariz. ¡Uy, pilas, nada de meter la mano!",
   "media": {
    "type": "file",
    "path": "trips/san-andres-3-dias/img/bigpond.jpg",
    "focus": 0.5
   },
   "stick": {
